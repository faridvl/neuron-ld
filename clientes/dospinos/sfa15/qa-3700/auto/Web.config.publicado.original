  <!-- Configuracion con la que NEGOCIO llama al Runner de integraciones (TCatalogo.vb). En los
       ambientes la fija pipelines\scripts\releases\sync-integration-settings.ps1. -->
  <appSettings>
    <add key="IntegrationStage" value="TESTING" />
    <add key="IntegrationTenant" value="DOS_PINOS" />
  </appSettings>
  <system.web>
    <!-- Backend: va en-US, NO en es-MX como los modulos de UI. No tiene interfaz, y en numeros
         en-US y es-MX son identicos ('.' decimal), asi que no se pierde nada. Se queda en en-US
         para mantener el acuerdo con el POS (que se fuerza en-US en codigo, RUTINAS/TRutinas.vb)
         y con el login de SQL, que esta en us_english/mdy en los tres servidores.
         Antes no se declaraba y se heredaba del web.config de Framework64 del servidor: funcionaba
         por casualidad, y en un servidor nuevo sin ese archivo cambiaba en silencio. -->
    <globalization culture="en-US" uiCulture="en-US" />
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="cfmx.ModuloIntegracion.Componentes.Extraccion.Extraccion_Ldcom_WebServices.cfcSoap11Binding" />
        <binding maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" maxBufferSize="2147483647">
          <readerQuotas maxDepth="200" maxStringContentLength="8388608" maxArrayLength="16384" maxBytesPerRead="2147483647" maxNameTableCharCount="16384" />
          <!--Usado con https-->
          <!--<security mode="Transport"/>-->
        </binding>
      </basicHttpBinding>
      <customBinding>
        <binding name="cfmx.ModuloIntegracion.Componentes.Extraccion.Extraccion_Ldcom_WebServices.cfcSoap12Binding">
          <textMessageEncoding messageVersion="Soap12" />
          <httpTransport />
        </binding>
      </customBinding>
    </bindings>
    <client>
      <endpoint address="http://192.168.2.18:8505/cfmx/ModuloIntegracion/Componentes/Extraccion/Extraccion_Ldcom_WebServices.cfc" binding="basicHttpBinding" bindingConfiguration="cfmx.ModuloIntegracion.Componentes.Extraccion.Extraccion_Ldcom_WebServices.cfcSoap11Binding" contract="Sif_WebService.cfmxModuloIntegracionComponentesExtraccionExtraccion_Ldcom_WebServicescfcPortType" name="cfmx.ModuloIntegracion.Componentes.Extraccion.Extraccion_Ldcom_WebServices.cfcHttpSoap11Endpoint" />
      <endpoint address="http://serversap2/WS_FE/FacturaElectronica.svc" binding="basicHttpBinding" contract="WCF_FE.IFacturaElectronica" name="BasicHttpBinding_IFacturaElectronica" />
      <endpoint address="http://localhost/LDCOM13/ServiciosWCF_LEALTAD/WCFPlanLealtad.svc" binding="basicHttpBinding" contract="WCF_PlanLealtad.IWCFPlanLealtad" name="BasicHttpBinding_IWCFPlanLealtad" />
    </client>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="True" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483647" maxQueryString="2147483647" maxUrl="2147483647" />
      </requestFiltering>
    </security>
  </system.webServer>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
